# ============================================================
# 全局指令文件 · command/boot.lbxscript
# ------------------------------------------------------------
# 本文件每一句都必须是 events/core.lbxevents 中已登记过的指令。
# 一行一句，支持 # 与 // 注释，也支持用分号分隔多条。
# ============================================================

# 打开欢迎窗口：参数为排版文件名（省略 .lbxlayout 后缀）
window(welcome)

# 顶部轻提示
notify("OriginalDeepsilenceHeart (ODH) 已就绪 · 试试标题栏最左侧的侧边栏与属性按钮")

# 指令集自检：hello() 由事件文件的 run 代码实现
hello("NoTificians")

# 壁纸：从图片链接设置桌面背景（也可在左下角“壁纸”里更换）
# setwall("https://example.com/wallpaper.jpg")

# 也支持在全局指令里直接改窗口属性
# set(welcome, opacity, 0.9)
