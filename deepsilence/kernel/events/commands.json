{
  "id": "commands.json",
  "name": "ODH 指令集",
  "version": 1,
  "about": "定义有哪些指令可用。events.json 里的事件和 HTML 里的 runEvent() 只能调用这里登记过的指令。builtin 指向引擎内置实现，run 则用一小段代码自定义指令。",
  "instructions": {
    "window": {
      "desc": "打开一个窗口，加载 layouts/ 下同名 .json 文件",
      "args": ["layout", "x", "y", "w", "h", "opacity"],
      "builtin": "window"
    },
    "close": {
      "desc": "关闭窗口；省略 id 时关闭当前聚焦窗口",
      "args": ["id"],
      "builtin": "close"
    },
    "minimize": {
      "desc": "最小化窗口到底部 dock",
      "args": ["id"],
      "builtin": "minimize"
    },
    "maximize": {
      "desc": "最大化 / 还原窗口",
      "args": ["id"],
      "builtin": "maximize"
    },
    "focus": {
      "desc": "召回并聚焦窗口",
      "args": ["id"],
      "builtin": "focus"
    },
    "page": {
      "desc": "切换窗口内的侧边栏页面",
      "args": ["id", "page"],
      "builtin": "page"
    },
    "set": {
      "desc": "修改窗口属性：x / y / w / h / opacity / radius / blur / padding / title",
      "args": ["id", "key", "value"],
      "builtin": "set"
    },
    "notify": {
      "desc": "顶部轻提示",
      "args": ["text"],
      "builtin": "notify"
    },
    "log": {
      "desc": "写入内核日志",
      "args": ["text"],
      "builtin": "log"
    },
    "exec": {
      "desc": "把一段指令文本当作新的指令序列执行",
      "args": ["text"],
      "builtin": "exec"
    },
    "setwall": {
      "desc": "设置桌面壁纸；留空恢复默认",
      "args": ["url"],
      "builtin": "setwall"
    },
    "dialog": {
      "desc": "弹出 Windows 风格模态对话框（type: info/warn/err）",
      "args": ["message", "type", "title"],
      "builtin": "dialog"
    },
    "notif": {
      "desc": "弹出 Android 风格顶部通知（type: info/warn/err/ok，自动消失）",
      "args": ["message", "type", "title", "duration"],
      "builtin": "notif"
    }
  }
}
