{
  "id": "studio",
  "base": {
    "title": "组件工坊",
    "icon": "<svg viewBox=\"0 0 24 24\"><line x1=\"4\" y1=\"8\" x2=\"20\" y2=\"8\"/><line x1=\"4\" y1=\"16\" x2=\"20\" y2=\"16\"/><circle cx=\"9\" cy=\"8\" r=\"2\"/><circle cx=\"15\" cy=\"16\" r=\"2\"/></svg>",
    "width": 660,
    "height": 540,
    "x": "center",
    "y": "center",
    "opacity": 0.95,
    "radius": 16,
    "blur": 22,
    "padding": 0,
    "minWidth": 420,
    "minHeight": 420,
    "resizable": true,
    "draggable": true
  },
  "sidebar": {
    "title": "目录",
    "items": []
  },
  "page": {
    "markup": "class 标题 = text(x=24, y=22, text=\"组件工坊\", size=22, weight=600, color=\"#ffffff\")\nclass 输入面板 = panel(x=24, y=72, w=380, h=124, title=\"输入对象\")\nclass 指令输入 = input(x=44, y=116, w=340, label=\"指令文本\", placeholder=\"输入后回车或点发送\", submit=\"发送\", action=\"notify($value)\")\nclass 通知按钮 = button(x=24, y=216, w=176, h=38, text=\"通知一条\", action=\"notify('来自 DSL 按钮的指令')\")\nclass 关闭按钮 = button(x=212, y=216, w=176, h=38, text=\"关闭窗口\", variant=\"danger\", action=\"close($win)\")\nclass 透明度 = slider(x=24, y=276, w=364, label=\"窗口透明度\", min=0.3, max=1, step=0.01, value=0.94, action=\"set($win, opacity, $value)\")\nclass 音源 = media(x=24, y=332, w=364, title=\"音源位\", sub=\"播放器占位\", src=\"tone:520:1.1\")\nclass 竖分隔 = divider(x=444, y=72, w=1, h=320, color=\"rgba(255,255,255,0.08)\")\nclass 最小化按钮 = button(x=470, y=80, w=166, h=34, text=\"最小化\", variant=\"ghost\", action=\"minimize($win)\")\nclass 还原透明度 = button(x=470, y=122, w=166, h=34, text=\"重置透明度\", variant=\"ghost\", action=\"set($win, opacity, 0.94)\")\nclass 右栏占位 = panel(x=470, y=176, w=166, h=216, title=\"内容位\")"
  }
}
