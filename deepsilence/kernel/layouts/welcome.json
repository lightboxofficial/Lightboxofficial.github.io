                                      "remark":  "结构页占位：分节、标题、四条带编号的内容行、底部注释。样式与脚本内嵌。",
                                      "html":  "<style>\n  .an {\n    padding: 24px 28px 74px;\n    animation: anIn 0.45s cubic-bezier(0.22, 0.9, 0.28, 1) both;\n  }\n  @keyframes anIn {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: none; }\n  }\n  .an-eye {\n    font-family: \"JetBrains Mono\", Consolas, monospace;\n    font-size: 10px;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: rgba(255, 255, 255, 0.28);\n    margin-bottom: 9px;\n  }\n  .an-title {\n    margin: 0 0 16px;\n    font-size: 22px;\n    line-height: 1.3;\n    font-weight: 600;\n    color: rgba(255, 255, 255, 0.9);\n  }\n  .an-row {\n    display: flex;\n    gap: 13px;\n    padding: 12px 14px;\n    border-radius: 11px;\n    border: 1px dashed rgba(255, 255, 255, 0.12);\n    background: rgba(255, 255, 255, 0.022);\n    margin-bottom: 8px;\n  }\n  .an-no {\n    width: 24px;\n    height: 24px;\n    flex-shrink: 0;\n    border-radius: 7px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: \"JetBrains Mono\", Consolas, monospace;\n    font-size: 10.5px;\n    color: #0d0d0f;\n    background: linear-gradient(160deg, #f7f7f8, #c9c9cf);\n    font-weight: 700;\n  }\n  .an-body {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    padding-top: 2px;\n  }\n  .an-slot {\n    font-size: 12px;\n    color: rgba(255, 255, 255, 0.42);\n  }\n  .an-line {\n    height: 8px;\n    border-radius: 4px;\n    background: rgba(255, 255, 255, 0.06);\n  }\n  .an-line.short {\n    width: 62%;\n  }\n  .an-foot {\n    margin-top: 14px;\n    padding-top: 12px;\n    border-top: 1px dashed rgba(255, 255, 255, 0.1);\n    font-size: 11px;\n    color: rgba(255, 255, 255, 0.26);\n  }\n</style>\n\n<div class=\"an\">\n  <div class=\"an-eye\">分节位</div>\n  <h1 class=\"an-title\">标题位</h1>\n\n  <div class=\"an-row\">\n    <div class=\"an-no\">1</div>\n    <div class=\"an-body\">\n      <d